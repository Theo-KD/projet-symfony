{% extends 'base.html.twig' %}

{% block body %}

<h1>Finaliser la commande</h1>

<div class="commande-wrapper">

    <!-- FORMULAIRE DE PAIEMENT (GAUCHE) -->
    <div class="paiement-box">

        <!-- BADGE SÉCURISÉ -->
        <div class="secure-badge">
            <span class="lock">🔒</span>
            Paiement sécurisé
        </div>

        <!-- LOGOS DES CARTES -->
        <div class="card-logos">
            <img src="/images/payments/cb.svg" alt="CB">
            <img src="/images/payments/visa.svg" alt="Visa">
            <img src="/images/payments/mastercard.svg" alt="Mastercard">
            <img src="/images/payments/amex.svg" alt="American Express">
        </div>

        <!-- POINTS FIDÉLITÉ DU CLIENT -->
        {% if app.user %}
            <div class="points-info-box">
                <img src="/images/points.png" alt="Points" class="points-icon">
                Vous avez <strong>{{ app.user.points }}</strong> points fidélité

                {% if peutReduc %}
                    <br>
                    <img src="/images/points.png" alt="Points" class="points-icon">
                    <span class="reduc-ok">Vous pouvez utiliser 1000 points pour une réduction de 10%</span>
                {% else %}
                    <br><span class="reduc-no">Il vous manque {{ 1000 - app.user.points }} points pour une réduction</span>
                {% endif %}
            </div>
        {% endif %}

        <form action="{{ path('commande_valider') }}" method="POST" class="paiement-form" id="paymentForm">

            {% if peutReduc %}
                <label class="reduction-check">
                    <input type="checkbox" id="usePoints" name="reduction" value="1">
                    Utiliser 1000 points (réduction 10%)
                </label>
            {% endif %}

            <h3>Informations bancaires</h3>
            <p class="required-info">* Champ obligatoire</p>

            <!-- NUMÉRO DE CARTE -->
            <div class="form-group">
                <label for="numero">Numéro de la carte *</label>
                <input 
                    type="text" 
                    id="numero"
                    name="numero" 
                    placeholder="4242 4242 4242 4242"
                    maxlength="19"
                    pattern="[0-9 ]{16,19}"
                    required
                >
            </div>

            <!-- DATE + CVC -->
            <div class="form-row">
                <div class="form-group small">
                    <label for="expiration">Date d’expiration *</label>
                    <input 
                        type="text" 
                        id="expiration"
                        name="expiration" 
                        placeholder="MM/AA"
                        maxlength="5"
                        pattern="[0-9]{2}/[0-9]{2}"
                        required
                    >
                </div>

                <div class="form-group small">
                    <label for="cvv">CVC *</label>
                    <input 
                        type="text" 
                        id="cvv"
                        name="cvv" 
                        placeholder="123"
                        maxlength="3"
                        pattern="[0-9]{3}"
                        required
                    >
                </div>
            </div>

            <!-- TITULAIRE -->
            <div class="form-group">
                <label for="titulaire">Titulaire de la carte *</label>
                <input 
                    type="text" 
                    id="titulaire"
                    name="titulaire" 
                    placeholder="Martin Dupont"
                    maxlength="40"
                    pattern="[A-Za-zÀ-ÿ ]+"
                    required
                >
            </div>

            <button class="btn-primary" id="payButton">
                <span class="btn-text">Payer et valider la commande</span>
                <span class="loader"></span>
            </button>

        </form>
    </div>

    <!-- RÉCAPITULATIF (DROITE) -->
    <div class="recap-box">
        <h3>Votre commande</h3>

        {% for item in items %}
            <div class="recap-item">
                <img src="{{ asset('images/plats/' ~ item.plat.image) }}" alt="">
                <div>
                    <strong>{{ item.plat.nom }}</strong>
                    <p>{{ item.quantity }} × {{ item.plat.prix }} €</p>
                </div>
                <strong>{{ item.total }} €</strong>
            </div>
        {% endfor %}

        <div class="total-box">
            Total : <span id="totalDisplay">{{ total }}</span> €
        </div>
    </div>

</div>

<!-- SCRIPT FORMATAGE + VALIDATION + LOADER + TOTAL DYNAMIQUE -->
<script>
document.addEventListener("DOMContentLoaded", () => {

    /* Loader */
    const form = document.getElementById("paymentForm");
    const button = document.getElementById("payButton");

    if (form && button) {
        form.addEventListener("submit", () => {
            button.classList.add("btn-loading");
            button.disabled = true;
        });
    }

    /* Titulaire : pas de chiffres */
    const titulaire = document.querySelector('#titulaire');
    titulaire.addEventListener("input", () => {
        titulaire.value = titulaire.value.replace(/[0-9]/g, "");
    });

    /* Numéro : XXXX XXXX XXXX XXXX */
    const numero = document.querySelector('#numero');
    numero.addEventListener("input", () => {
        numero.value = numero.value
            .replace(/\D/g, "")
            .replace(/(.{4})/g, "$1 ")
            .trim();
    });

    /* Expiration : MM/AA */
    const expiration = document.querySelector('#expiration');
    expiration.addEventListener("input", () => {
        let v = expiration.value.replace(/\D/g, "");

        if (v.length >= 2) {
            let mois = parseInt(v.slice(0, 2));
            if (mois === 0) mois = 1;
            if (mois > 12) mois = 12;

            v = mois.toString().padStart(2, "0") 
                + (v.length > 2 ? "/" + v.slice(2, 4) : "");
        }

        expiration.value = v;
    });

    /* --- TOTAL DYNAMIQUE AVEC POINTS --- */
    const checkbox = document.getElementById("usePoints");
    const totalDisplay = document.getElementById("totalDisplay");
    const totalInitial = parseFloat(totalDisplay.textContent);

    if (checkbox) {
        checkbox.addEventListener("change", () => {
            if (checkbox.checked) {
                const reduc = totalInitial * 0.10;
                const max = totalInitial * 0.20;
                const reductionFinale = Math.min(reduc, max);

                totalDisplay.textContent = (totalInitial - reductionFinale).toFixed(2);
            } else {
                totalDisplay.textContent = totalInitial.toFixed(2);
            }
        });
    }

});
</script>

{% endblock %}
